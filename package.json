{
  "name": "anomoly-chat",
  "version": "1.0.0",
  "description": "Temporary, accountless peer-to-peer chat and document sharing using WebRTC.",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/index.test.js",
    "test:smoke": "node scripts/e2e-smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skandachandrashekar335-wq/anomoly-chat.git"
  },
  "keywords": [
    "anonymous-chat",
    "webrtc",
    "peer-to-peer",
    "ephemeral",
    "document-sharing",
    "vercel",
    "privacy"
  ],
  "author": "",
  "license": "Apache-2.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/skandachandrashekar335-wq/anomoly-chat/issues"
  },
  "homepage": "https://github.com/skandachandrashekar335-wq/anomoly-chat#readme",
  "dependencies": {
    "express": "^5.3.0",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "playwright": "^1.64.1",
    "puppeteer-core": "^25.16.0"
  }
